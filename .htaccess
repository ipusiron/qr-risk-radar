# Apache に置くときのヘッダー（GitHub Pages はこのファイルを使わない。CSP は index.html の meta と同じ値に frame-ancestors を足したもの）
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; worker-src blob:; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    # カメラはこのページ自身だけに許す
    Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

Options -Indexes

# 作業用のファイルを配らない
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql|conf|mjs)$">
    Require all denied
</FilesMatch>
